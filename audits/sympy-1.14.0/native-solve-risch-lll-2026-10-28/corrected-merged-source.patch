@@ -0,0 +1,94 @@
+"""Protocol checks for exact QQ triangular substitution; no arithmetic here."""
+from types import ModuleType,WrapperDescriptorType,MethodDescriptorType,GetSetDescriptorType
+from symox import _core
+from ..domains import _algebraic_methods
+from .exceptions import DMNonInvertibleMatrixError
+
+if '_CAPTURED' not in globals():
+    _CAPTURED=True
+    _TYPE=False.__class__.__class__
+    _LIST=[].__class__
+    _TUPLE=().__class__
+    _STR=''.__class__
+    _OBJECT=_LIST.__bases__[0]
+    _FUNCTION=(lambda:None).__class__
+    _CODE=(lambda:None).__code__.__class__
+    _DOMAIN,_ELEMENT=_core.Domain,_core.DomainElement
+    _RANGE,_REVERSED=range,reversed
+    _ELEMENT_HOOKS=[(n,_ELEMENT.__dict__.get(n)) for n in ('__bool__','__mul__','__sub__','parent')]
+    _DOMAIN_HOOKS=[(n,_DOMAIN.__dict__.get(n)) for n in ('is_ZZ_I','is_QQ_I')]
+    _ERROR=DMNonInvertibleMatrixError
+    _ERROR_MRO=_ERROR.__mro__
+    _ERROR_CLASSES=[(cls,list(cls.__dict__.items())) for cls in _ERROR_MRO
+                    if cls is not Exception and cls is not BaseException and cls is not _OBJECT]
+    _DIV_CODE=None
+    for _constant in _algebraic_methods._gaussian_binary.__code__.co_consts:
+        if _TYPE(_constant) is _CODE and _constant.co_name=='method':_DIV_CODE=_constant
+
+
+def _method(value,cls,name,kinds):
+    return _TYPE(value) in kinds and value.__objclass__ is cls and value.__name__==name
+
+
+def _error_stock():
+    if _TYPE(_ERROR) is not _TYPE:return False
+    mro=_ERROR.__mro__
+    if mro.__len__()!=_ERROR_MRO.__len__():return False
+    index=0
+    for original in _ERROR_MRO:
+        if mro[index] is not original:return False
+        index+=1
+    for cls,items in _ERROR_CLASSES:
+        if _TYPE(cls) is not _TYPE:return False
+        current=cls.__dict__
+        if current.__len__()!=items.__len__():return False
+        for name in current:
+            if _TYPE(name) is not _STR:return False
+        for name,value in items:
+            if current.get(name) is not value:return False
+        # Canonical DomainMatrix exception classes declare no user constructors,
+        # getters or finalizers. A modification before import is not trusted.
+        for name in current:
+            if name not in ('__module__','__doc__','__weakref__'):return False
+    return True
+
+
+def _protocol(dependencies):
+    if (_TYPE(_core) is not ModuleType or _TYPE(_algebraic_methods) is not ModuleType
+            or _TYPE(dependencies) is not _TUPLE or dependencies.__len__()!=3):return False
+    if dependencies[0] is not _RANGE or dependencies[1] is not _REVERSED or dependencies[2] is not _ERROR:return False
+    for kind,name in ((_RANGE,'range'),(_REVERSED,'reversed')):
+        if (_TYPE(kind) is not _TYPE or kind.__flags__ & (1<<9)
+                or kind.__module__!='builtins' or kind.__name__!=name):return False
+    if not _error_stock():return False
+    if (_core.__dict__.get('Domain') is not _DOMAIN or _core.__dict__.get('DomainElement') is not _ELEMENT):return False
+    for cls in (_DOMAIN,_ELEMENT):
+        if _TYPE(cls) is not _TYPE or cls.__bases__!=(_OBJECT,):return False
+        for name in ('__getattribute__','__getattr__','__class__'):
+            if name in cls.__dict__:return False
+    if '__isub__' in _ELEMENT.__dict__:return False
+    for name,original in _ELEMENT_HOOKS:
+        if _ELEMENT.__dict__.get(name) is not original:return False
+        kinds=(MethodDescriptorType,) if name=='parent' else (WrapperDescriptorType,)
+        if not _method(original,_ELEMENT,name,kinds):return False
+    for name,original in _DOMAIN_HOOKS:
+        if _DOMAIN.__dict__.get(name) is not original or not _method(original,_DOMAIN,name,(GetSetDescriptorType,)):return False
+    divide=_ELEMENT.__dict__.get('__truediv__')
+    if (_TYPE(divide) is not _FUNCTION or divide.__code__ is not _DIV_CODE
+            or divide.__globals__ is not _algebraic_methods.__dict__
+            or divide.__defaults__ is not None or divide.__kwdefaults__ is not None):return False
+    closure=divide.__closure__
+    if closure is None or closure.__len__()!=3:return False
+    try:native,operation,reflected=(cell.cell_contents for cell in closure)
+    except ValueError:return False
+    return (_method(native,_ELEMENT,'__truediv__',(WrapperDescriptorType,))
+            and _TYPE(operation) is _STR and operation=='truediv' and reflected is False)
+
+
+def try_solve(x,l,u,b,y,dimensions,stock,dependencies):
+    if not _protocol(dependencies):return False
+    if stock is not None:
+        if _TYPE(stock) is not _TYPE or stock.__bases__!=(_LIST,):return False
+        for name in ('__iter__','__len__','__getitem__','__setitem__','__new__'):
+            if stock.__dict__.get(name,_LIST.__dict__[name]) is not _LIST.__dict__[name]:return False
+    return _core._ddm_ilu_solve(x,l,u,b,y,dimensions,stock,_ERROR)
