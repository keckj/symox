+        GD2=mul(GD,GD);DG=mul(sub(mul(diff(GA),GD),mul(GA,diff(GD))),tau)
+        assert mul(A,mul(GD2,mul(HD,DR)))==add(mul(D,mul(DG,mul(HD,DR))),
+            add(mul(D,mul(HA,mul(GD2,DR))),mul(D,mul(R,mul(GD2,HD)))))
