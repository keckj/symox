+#[pyfunction]
+pub(super) fn _lll_abc_state(value: &Bound<'_, PyAny>, dump: &Bound<'_,PyAny>, py: Python<'_>) -> PyResult<Option<PyObject>> {
+    if !authenticated_dump(dump)? { return Ok(None); }
