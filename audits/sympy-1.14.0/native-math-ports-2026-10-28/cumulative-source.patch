+    let owner = unsafe { Bound::<PyAny>::from_borrowed_ptr(dump.py(), owner) };
+    let namespace = owner.downcast_exact::<PyModule>()?.dict();
+    for (key,_) in namespace.iter() {
+        if key.downcast_exact::<PyString>().is_err() { return Ok(false); }
