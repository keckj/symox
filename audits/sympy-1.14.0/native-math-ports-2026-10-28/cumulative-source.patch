+pub(super) fn register(module: &Bound<'_, PyModule>) -> PyResult<()> {
+    module.add_function(wrap_pyfunction!(_lll_loaded_modules,module)?)?;
+    module.add_function(wrap_pyfunction!(_lll_module_registry,module)?)?;
