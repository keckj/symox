+PROTOCOL_SCRIPT="import ast,builtins,copy,importlib,json,sys,types\nfrom pathlib import Path\nfrom fractions import Fraction\nimport symox as sx\nfrom symox.polys.matrices.ddm import DDM\nddm_module=importlib.import_module('symox.polys.matrices.ddm')\nprinting=importlib.import_module('symox.polys.domains._element_print')\nalgebraic=importlib.import_module('symox.polys.domains._algebraic_methods')\nNATIVE_NAMES=('_ddm_fflu','_ddm_fflu_p','_ddm_fflu_l','_ddm_fflu_d')\ndef python_function(name):\n    tree=ast.parse(Path(ddm_module.__file__).read_text())\n    cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='DDM')\n    node=copy.deepcopy(next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name==name))\n    body=[]\n    for statement in node.body:\n        if isinstance(statement,ast.If) and isinstance(statement.test,ast.Call) and isinstance(statement.test.func,ast.Name) and statement.test.func.id=='_native_fflu':continue\n        if isinstance(statement,ast.If) and isinstance(statement.test,ast.UnaryOp) and isinstance(statement.test.op,ast.Not) and isinstance(statement.test.operand,ast.Call) and isinstance(statement.test.operand.func,ast.Name) and statement.test.operand.func.id.startswith('_native_fflu_'):\n            body.extend(statement.body)\n        else:body.append(statement)\n    node.body=body\n    code=compile(ast.fix_missing_locations(ast.Module(body=[node],type_ignores=[])),ddm_module.__file__,'exec')\n    return types.FunctionType(next(c for c in code.co_consts if type(c)is types.CodeType),ddm_module.__dict__)\nmode,target=sys.argv[1:3]\na=DDM([[sx.ZZ(v) for v in row] for row in [[0,0,1,2],[0,0,2,3]]],(2,4),sx.ZZ)\nb=DDM([[sx.ZZ(v) for v in row] for row in [[0,0,1,2],[0,0,2,3]]],(2,4),sx.ZZ)\npure_private=python_function('_fflu');pure_public=python_function('fflu');b._fflu=types.MethodType(pure_private,b)\ncore=sx._core;events=[];calls=[];audit_events=[];restore_core=False\nfor name in NATIVE_NAMES:\n native=getattr(core,name)\n def record(*args,_name=name,_native=native,**kwargs):\n  result=_native(*args,**kwargs);calls.append((_name,result));return result\n setattr(core,name,record)\nowner=algebraic if target=='_exquo' else printing\noriginal=owner.__dict__.get(target)\nclass TupleSubclass(tuple):\n def __len__(self):events.append('tuple-len');raise AssertionError('tuple-len')\n def __iter__(self):events.append('tuple-iter');raise AssertionError('tuple-iter')\n def __getitem__(self,key):events.append('tuple-getitem');raise AssertionError('tuple-getitem')\n def __eq__(self,other):events.append('tuple-eq');raise AssertionError('tuple-eq')\nclass DictSubclass(dict):\n def __getitem__(self,key):events.append('dict-getitem');raise AssertionError('dict-getitem')\n def __iter__(self):events.append('dict-iter');raise AssertionError('dict-iter')\n def __len__(self):events.append('dict-len');raise AssertionError('dict-len')\ndef replace_function(function):\n owner.__dict__[target]=function\n if target in ('_eq','_ne'):setattr(core.DomainElement,'__'+target.strip('_')+'__',function)\n if target=='_exquo':core.Domain.exquo=function\nif mode in ('closure','defaults','kwdefaults','consts','cached-builtins'):\n code,namespace,name,defaults=original.__code__,original.__globals__,original.__name__,original.__defaults__\n if mode=='closure':function=types.FunctionType(code,namespace,name,defaults,TupleSubclass(()))\n elif mode=='defaults':function=types.FunctionType(code,namespace,name,TupleSubclass(()))\n elif mode=='kwdefaults':\n  function=types.FunctionType(code,namespace,name,defaults);function.__kwdefaults__=DictSubclass()\n elif mode=='consts':function=types.FunctionType(code.replace(co_consts=TupleSubclass(code.co_consts)),namespace,name,defaults)\n else:\n  original_builtins=namespace['__builtins__'];foreign=dict(builtins.__dict__)\n  def observed_type(*args):events.append('cached-type');return type(*args)\n  foreign['type']=observed_type\n  namespace['__builtins__']=foreign\n  try:function=types.FunctionType(code,namespace,name,defaults)\n  finally:namespace['__builtins__']=original_builtins\n replace_function(function)\nelif mode=='changed-before-import':\n saved=types.FunctionType(original.__code__,original.__globals__,original.__name__,original.__defaults__)\n owner.__dict__['_fflu_test_events']=events;owner.__dict__['_fflu_test_saved']=saved\n def observer(*args):\n  _fflu_test_events.append('changed-code');return _fflu_test_saved(*args)\n original.__code__=observer.__code__\nelif mode=='metadata-object':\n class Foreign:\n  def __getattribute__(self,name):events.append('foreign-getattr');raise AssertionError(name)\n core.__dict__['_ddm_function_metadata']=Foreign()\nelif mode=='core-key':\n key_hash=hash('_ddm_function_metadata');core.__dict__.pop('_ddm_function_metadata')\n class ForeignKey:\n  def __hash__(self):return key_hash\n  def __eq__(self,other):events.append('foreign-eq');raise AssertionError('foreign-eq')\n core.__dict__[ForeignKey()]=17\nelif mode=='core-module':\n from types import ModuleType\n class ForeignModule(ModuleType):\n  def __getattribute__(self,name):events.append('foreign-module');raise RuntimeError(name)\n core.__class__=ForeignModule;restore_core=True\nif mode=='changed-before-import' or target=='preimport':\n module_name='symox.polys.matrices._fflu_native';sys.modules.pop(module_name,None);guard=importlib.import_module(module_name);guard.register(DDM)\n for name,function in [('_native_fflu',guard.try_eliminate),('_native_fflu_p',guard.try_permutation),('_native_fflu_l',guard.try_lower),('_native_fflu_d',guard.try_diagonal)]:setattr(ddm_module,name,function)\nif mode=='audit':\n def audit(event,args):\n  if event=='object.__getattr__':audit_events.append(args[1]);raise AssertionError('speculative audit '+args[1])\n sys.addaudithook(audit)\ndef execute(function):\n events.clear();calls.clear()\n try:out=function()\n except Exception as error:return {'error':type(error).__name__,'message':str(error)},events[:],calls[:]