+@pytest.mark.parametrize('mode,target',[('audit','_eq')]+[(mode,target) for mode in ('closure','defaults','kwdefaults','consts','cached-builtins','changed-before-import') for target in ('_int_congruent','_eq','_ne','_exquo')]+[(mode,phase) for mode in ('metadata-object','core-key','core-module') for phase in ('call','preimport')])
+def test_metadata_protocol_controls_have_no_added_observations_and_full_results(mode,target):
+    result=subprocess.run([sys.executable,'-c',PROTOCOL_SCRIPT,mode,target],env=dict(os.environ,PYTHONPATH=str(Path(sx.__file__).resolve().parents[1])),capture_output=True,text=True,timeout=45)
+    assert result.returncode==0,result.stderr
+    data=json.loads(result.stdout)
+    assert data['reference_imported'] is False and data['audit_events']==[]
+    if mode=='audit':assert data['native_calls']==[[name,True] for name in NATIVE_NAMES]
+    else:assert data['native_calls']==[]
+    if mode in ('closure','defaults','kwdefaults','consts','metadata-object','core-key'):assert data['actual_events']==[] and 'factors' in data['actual']
