+@pytest.mark.parametrize('domain',['ZZ','QQ'])
+def test_unbounded_exact_coefficients_and_rational_denominators(domain,monkeypatch):
+    big=2**768+49
+    integer_rows=[[0,big+2,big+3,big+5],[0,big+7,big+11,big+13],[0,big+17,big+19,big+23]]
+    rows=integer_rows if domain=='ZZ' else [[Fraction(v,big+29) for v in row] for row in integer_rows]
+    k=getattr(sx,domain);a=DDM(cells(rows,k),(3,4),k);calls=[]
+    for name in NATIVE_NAMES:
+        native=getattr(sx._core,name)
+        def record(*args,_name=name,_native=native,**kwargs):
+            result=_native(*args,**kwargs);calls.append((_name,result));return result
+        monkeypatch.setattr(sx._core,name,record)
+    p,l,d,u=a.fflu()
+    assert calls==[(name,True) for name in NATIVE_NAMES]
+    proof=certify(numbers(rows),3,4,*[values(v) for v in (p,l,d,u)])
+    assert proof['complete_certificate'] and proof['rank_A']==3 and proof['pivot_columns']==[1,2,3]
+    assert all(v.domain is k for v in (p,l,d,u)) and values(a)==numbers(rows)
