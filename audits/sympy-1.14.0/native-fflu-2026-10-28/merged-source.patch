+@pytest.mark.parametrize('entry',['ddm','dense','sparse'])
+@pytest.mark.parametrize('case',CASES,ids=lambda c:c['id'])
+def test_complete_public_factorization_canonical_pivots_and_first_native_routes(case,entry,monkeypatch):
+    a=source(case,entry);before=values(a);calls=[]
+    for name in NATIVE_NAMES:
+        native=getattr(sx._core,name)
+        def record(*args,_name=name,_native=native,**kwargs):
+            result=_native(*args,**kwargs);calls.append((_name,result));return result
+        monkeypatch.setattr(sx._core,name,record)
+    out=a.fflu()
+    assert calls==[(name,True) for name in NATIVE_NAMES]
+    actual=[values(v) for v in out]
+    assert actual==[numbers(case['factors'][name]) for name in 'PLDU']
+    m,n=case['shape'];proof=certify(before,m,n,*actual)
+    assert proof['complete_certificate'] and proof['rank_A']==case['rank'] and proof['pivot_columns']==case['pivots']
+    assert all(v.domain is a.domain for v in out)
+    assert values(a)==before
+    if entry=='sparse':assert all(v.rep.fmt=='sparse' for v in out)
+    elif entry=='dense':assert all(v.rep.fmt=='dense' for v in out)
+
