+@pytest.mark.parametrize('k',[sx.ZZ,sx.QQ])
+def test_isolated_zero_vertices_keep_sparse_leading_indices_for_huge_dimensions(k):
+    n=sys.maxsize
+    a={n-9:{n-9:k(2),n-2:k(3)},n-2:{n-9:k(5),n-2:k(7)}}
