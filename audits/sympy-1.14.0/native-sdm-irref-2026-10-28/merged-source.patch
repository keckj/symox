+#[pyfunction]
+#[pyo3(signature=(a,stock=None))]
+fn _sdm_irref<'py>(a:&Bound<'py,PyAny>,stock:Option<&Bound<'py,PyAny>>,py:Python<'py>)
+    ->PyResult<Option<(PyObject,PyObject,PyObject)>> {
