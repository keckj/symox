{"name": "var_of_parameters_13", "hint": "nth_linear_constant_coeff_variation_of_parameters", "hint_sol": "Eq(f(x), C1 + x**2 + (C2 + x*(C3 - x/8) + 5*exp(2*I*x)/16)*sin(x) + (C4 + x*(C5 + I*x/8) + 5*I*exp(2*I*x)/16)*cos(x) - I*exp(I*x))", "nosimp": "Eq(f(x), C1 + C2*sin(x) + C3*cos(x) + C4*x*sin(x) + C5*x*cos(x) + x**2 + x*(-4*x*(sin(x)/16 - sin(3*x)/48) - 4*x*(3*sin(x)/16 + sin(3*x)/48) - x/4 - I*exp(4*I*x)/64 + I*exp(2*I*x)/8 - 3*exp(I*x)*sin(3*x)/64 - I*exp(I*x)*cos(3*x)/64 - cos(x) + I*exp(-2*I*x)/32)*sin(x) - x*(-4*x*(-3*cos(x)/16 + cos(3*x)/48) - 4*x*(-cos(x)/16 - cos(3*x)/48) - I*x/4 + exp(4*I*x)/64 + exp(2*I*x)/8 + I*exp(I*x)*sin(3*x)/64 - 3*exp(I*x)*cos(3*x)/64 - sin(x) + exp(-2*I*x)/32)*cos(x) + (4*x**2*(sin(x)/16 - sin(3*x)/48) + 4*x**2*(3*sin(x)/16 + sin(3*x)/48) - x**2/8 - 8*x*(-3*cos(x)/16 + cos(3*x)/48) - 8*x*(-cos(x)/16 - cos(3*x)/48) + 2*x*(x/32 + I*exp(4*I*x)/128 - I*exp(2*I*x)/64 - I*exp(-2*I*x)/64) + 2*x*(3*x/32 - 3*I*exp(2*I*x)/64 + 3*exp(I*x)*sin(3*x)/128 + I*exp(I*x)*cos(3*x)/128) + 2*x*cos(x) - I*x/2 - I*(3*exp(I*x)*sin(3*x)/8 + I*exp(I*x)*cos(3*x)/8)/64 + 7*exp(4*I*x)/256 + 5*exp(2*I*x)/16 + 13*I*exp(I*x)*sin(3*x)/512 - 39*exp(I*x)*cos(3*x)/512 - 4*sin(x) + 3*exp(-2*I*x)/64)*sin(x) - (4*x**2*(-3*cos(x)/16 + cos(3*x)/48) + 4*x**2*(-cos(x)/16 - cos(3*x)/48) - I*x**2/8 + 8*x*(sin(x)/16 - sin(3*x)/48) + 8*x*(3*sin(x)/16 + sin(3*x)/48) + 2*x*(I*x/32 - exp(4*I*x)/128 - exp(2*I*x)/64 - exp(-2*I*x)/64) + 2*x*(3*I*x/32 - 3*exp(2*I*x)/64 - I*exp(I*x)*sin(3*x)/128 + 3*exp(I*x)*cos(3*x)/128) + 2*x*sin(x) + x/2 + I*(I*exp(I*x)*sin(3*x)/8 - 3*exp(I*x)*cos(3*x)/8)/64 + 7*I*exp(4*I*x)/256 - 5*I*exp(2*I*x)/16 + 39*exp(I*x)*sin(3*x)/512 + 13*I*exp(I*x)*cos(3*x)/512 + 4*cos(x) - 3*I*exp(-2*I*x)/64)*cos(x) - I*exp(I*x))"}
{"name": "var_of_parameters_14", "hint": "nth_linear_constant_coeff_variation_of_parameters", "hint_sol": "Eq(f(x), C1 + (C2 + x*(C3 - x/8) + 5*exp(2*I*x)/16)*sin(x) + (C4 + x*(C5 + I*x/8) + 5*I*exp(2*I*x)/16)*cos(x) - I*exp(I*x))", "nosimp": "Eq(f(x), C1 + C2*sin(x) + C3*cos(x) + C4*x*sin(x) + C5*x*cos(x) + x*(-x/4 - I*exp(4*I*x)/64 + I*exp(2*I*x)/8 - 3*exp(I*x)*sin(3*x)/64 - I*exp(I*x)*cos(3*x)/64 + I*exp(-2*I*x)/32)*sin(x) - x*(-I*x/4 + exp(4*I*x)/64 + exp(2*I*x)/8 + I*exp(I*x)*sin(3*x)/64 - 3*exp(I*x)*cos(3*x)/64 + exp(-2*I*x)/32)*cos(x) + (-x**2/8 + 2*x*(x/32 + I*exp(4*I*x)/128 - I*exp(2*I*x)/64 - I*exp(-2*I*x)/64) + 2*x*(3*x/32 - I*exp(4*I*x)/128 - 3*I*exp(2*I*x)/64 + I*exp(-2*I*x)/64) - I*x/2 + exp(4*I*x)/32 + 5*exp(2*I*x)/16 + I*exp(I*x)*sin(3*x)/32 - 3*exp(I*x)*cos(3*x)/32 + exp(-2*I*x)/16)*sin(x) - (-I*x**2/8 + 2*x*(I*x/32 - exp(4*I*x)/128 - exp(2*I*x)/64 - exp(-2*I*x)/64) + 2*x*(3*I*x/32 + exp(4*I*x)/128 - 3*exp(2*I*x)/64 + exp(-2*I*x)/64) + x/2 + I*exp(4*I*x)/32 - 5*I*exp(2*I*x)/16 + 3*exp(I*x)*sin(3*x)/32 + I*exp(I*x)*cos(3*x)/32 - I*exp(-2*I*x)/16)*cos(x) - I*exp(I*x))"}
{"name": "euler_undet_01", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), C1 + C2*log(x) + log(x)**2/2)", "nosimp": "Eq(f(x), C1 + C2*log(x) + log(x)**2/2)"}
