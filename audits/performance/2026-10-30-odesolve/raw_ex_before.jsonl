{"name": "euler_undet_03", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), (C1 + C2*x**4 - 2*log(x)**2 - log(x))/(16*x))", "nosimp": "Eq(f(x), C1/x + C2*x**3 - log(x)**2/(8*x) - log(x)/(16*x))"}
{"name": "euler_undet_04", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), C1/x**4 + C2*x**2 - log(x)**3/8 - 3*log(x)**2/32 - log(x)/64 - 7/256)", "nosimp": "Eq(f(x), C1/x**4 + C2*x**2 - log(x)**3/8 - 3*log(x)**2/32 - log(x)/64 - 7/256)"}
{"name": "euler_undet_05", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), C1*x + C2*x**2 + C3*x**3 - log(x)/6 - 11/36)", "nosimp": "Eq(f(x), C1*x + C2*x**2 + C3*x**3 - log(x)/6 - 11/36)"}
{"name": "euler_undet_06", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), sqrt(x)*(C1*sin(log(x)/2) + C2*cos(log(x)/2) + sqrt(2)*log(x)*cos(log(2*x)/2))/2)", "nosimp": "Eq(f(x), C1*sqrt(x)*sin(log(x)/2) + C2*sqrt(x)*cos(log(x)/2) + sqrt(2)*sqrt(x)*log(x)*cos(log(x)/2 + log(2)/2)/2)"}
{"name": "euler_undet_07", "hint": "nth_linear_euler_eq_nonhomogeneous_undetermined_coefficients", "hint_sol": "Eq(f(x), C1*sqrt(x)*sin(log(x)/2) + C2*sqrt(x)*cos(log(x)/2) - 2*sin(log(2*x)/2)/5 - 4*cos(log(2*x)/2)/5)", "nosimp": "Eq(f(x), C1*sqrt(x)*sin(log(x)/2) + C2*sqrt(x)*cos(log(x)/2) - 2*sin(log(x)/2 + log(2)/2)/5 - 4*cos(log(x)/2 + log(2)/2)/5)"}
{"name": "euler_var_01", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), x*(C1 + C2*x + x**3/6))", "nosimp": "Eq(f(x), C1*x + C2*x**2 + x**4/6)"}
{"name": "euler_var_02", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), C1/x**2 + C2*x + x*exp(x)/3 - 4*exp(x)/3 + 8*exp(x)/(3*x) - 8*exp(x)/(3*x**2))", "nosimp": "Eq(f(x), C1/x**2 + C2*x + x**2*((x - 1)*exp(x)/(9*x) - (x**4 - 4*x**3 + 12*x**2 - 24*x + 24)*exp(x)/(9*x**4)))"}
{"name": "euler_var_03", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), x*(C1 + C2*x + x*exp(x) - 2*exp(x)))", "nosimp": "Eq(f(x), C1*x + C2*x**2 + x**2*((x - 1)*exp(x) - (x**2 - 2*x + 2)*exp(x)/x))"}
{"name": "euler_var_04", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), C1*x + C2*x**2 + log(x)/2 + 3/4)", "nosimp": "Eq(f(x), C1*x + C2*x**2 + x**2*(-(-log(x)/x - 1/x)/x - log(x)/(2*x**2) - 1/(4*x**2)))"}
{"name": "euler_var_05", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), C1 + C2*log(x) + exp(x) - Ei(x))", "nosimp": "Eq(f(x), C1 + C2*log(x) + x**2*((x - 1)*exp(x)*log(x)/x**2 - ((x - 1)*exp(x)*log(x) - exp(x) + Ei(x))/x**2))"}
{"name": "euler_var_06", "hint": "nth_linear_euler_eq_nonhomogeneous_variation_of_parameters", "hint_sol": "Eq(f(x), C1*sin(2*log(x)) + C2*cos(2*log(x)) + 1/(5*x))", "nosimp": "Eq(f(x), C1*sin(2*log(x)) + C2*cos(2*log(x)) + C3*sin(2*log(x)) + C4*cos(2*log(x)) + x**2*(-(-sin(2*log(x))/(10*x*sin(2*log(x))**2 + 10*x*cos(2*log(x))**2) - 2*cos(2*log(x))/(10*x*sin(2*log(x))**2 + 10*x*cos(2*log(x))**2))*cos(2*log(x))/x**2 + (2*sin(2*log(x))/(10*x*sin(2*log(x))**2 + 10*x*cos(2*log(x))**2) - cos(2*log(x))/(10*x*sin(2*log(x))**2 + 10*x*cos(2*log(x))**2))*sin(2*log(x))/x**2))"}
