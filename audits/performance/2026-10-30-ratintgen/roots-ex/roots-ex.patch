+fn preprocess_expression(f: &UPoly) -> Option<UPoly> {
+    let p = f.expression()?;
+    let (_, p) = p.clear_denoms().ok()?;
+    let (_, p) = p.primitive().ok()?;
+    let c = p.all_coeffs();
+    if c.len() != f.c.len() || !super::expression_domain::construct_selects_expression(&c).ok()? {
+        return None;
+    }
+    Some(UPoly { c, numerical: false })
